# Backend environment configuration
# Copy this file to ".env" and fill in your values.

# PostgreSQL connection (libpq connection string)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://armada_dev:armada_dev_pass@localhost:5433/armada_control

# Secret used to sign JWT access tokens. Use a long random string in production.
JWT_SECRET=dev-secret-change-me-in-production

# Access token lifetime (e.g. "15m", "2h", "7d")
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (where the React app is served)
CLIENT_ORIGIN=http://localhost:5174

# Port the API server listens on
PORT=4001